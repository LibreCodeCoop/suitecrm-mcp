# Deployment variables. Copy to .env.deploy locally and NEVER commit it.
APP_UID=1000
APP_GID=1000

SUITECRM_BASE_URL=https://crm.example.com/legacy
# Confidential Authorization Code client created in SuiteCRM.
# Callback must equal https://crm.example.com/suitecrm-mcp-auth/callback
SUITECRM_AUTH_CLIENT_ID=

# The issuer identifies OAuth identity on the EXISTING public SuiteCRM domain.
MCP_OAUTH_ISSUER=https://crm.example.com/suitecrm-mcp-auth
# Exact origin for tunnel OAuth discovery (scheme + host, no path).
MCP_OAUTH_ORIGIN=https://crm.example.com
# DNS alias by which the existing HTTPS reverse proxy reaches oauth-edge.
MCP_OAUTH_EDGE_ALIAS=suitecrm-mcp-oauth-edge
# OAuth client pre-registered with the ChatGPT connector; exact callback.
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_REDIRECT_URI=

# New OpenAI Secure MCP Tunnel ID and its exact hosted MCP resource.
# Never copy the SYNTHETIC 012345... tunnel ID from automated tests.
OPENAI_TUNNEL_ID=
MCP_RESOURCE_URI=
# Example once a REAL id exists:
# MCP_RESOURCE_URI=https://api.openai.com/v1/mcp/<YOUR_REAL_TUNNEL_ID>

# Internal PHP backend hostnames, no public MCP host.
MCP_ALLOWED_HOSTS=127.0.0.1,localhost,nginx

# Runtime key: file secrets/openai_tunnel_runtime_api_key (never paste it here).
# Personal SuiteCRM OAuth client secret: secrets/suitecrm_auth_client_secret
# Token encryption key: secrets/token_encryption_key (base64 of 32 random bytes).
# Manager approval public key: secrets/approver_public_key
# MCP_ALLOW_WRITES and MCP_WORKFLOWS_REVIEWED remain false in Compose.
